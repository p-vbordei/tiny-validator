{
  "name": "tiny-validator",
  "version": "0.1.0",
  "description": "A tiny Zod-like schema validator with TypeScript inference. Chainable builders, refine/transform, helpful error paths. Zero dependencies, ~250 LoC.",
  "keywords": ["validator", "schema", "zod", "typescript", "validation"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=18" },
  "author": { "name": "Vlad Bordei", "email": "bordeivlad@gmail.com", "url": "https://github.com/p-vbordei" },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/p-vbordei/tiny-validator.git" },
  "bugs": { "url": "https://github.com/p-vbordei/tiny-validator/issues" },
  "homepage": "https://github.com/p-vbordei/tiny-validator#readme",
  "devDependencies": { "typescript": "^5.5.0", "vitest": "^2.0.0" }
}
